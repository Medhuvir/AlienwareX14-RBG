<Application x:Class="AlienRgb.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnAppStartup">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0F16"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#131A26"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#31D2E0"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D8E1EC"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#7A8899"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C2635"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2C3A4E"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2635"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2C3A4E"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </Application.Resources>
</Application>
